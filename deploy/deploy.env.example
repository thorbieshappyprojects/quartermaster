# Copy to ./deploy.env (repo root, gitignored) and fill in.
# SSH target of the VPS (non-root deploy user, key login).
DEPLOY_HOST=deploy@SERVER
# Directory the web container serves; must be inside /opt/quartermaster.
DEPLOY_PATH=/opt/quartermaster/site
# Public URL, e.g. https://quartermaster.<your-domain> (used by scripts/deploy_verify.sh)
DEPLOY_URL=
# No login in front for now; remove this line once a Cloudflare Access application protects the site.
ACCESS_MODE=public
