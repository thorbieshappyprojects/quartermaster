{
  "name": "quartermaster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Quartet-style card game for learning military equipment and ranks.",
  "scripts": {
    "dev": "npm run build:data && vite",
    "validate": "tsx scripts/validate.ts",
    "build:data": "tsx scripts/build-data.ts",
    "report": "tsx scripts/report.ts",
    "research": "tsx scripts/research/research.ts",
    "typecheck": "npm run build:data && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run validate && npm run build:data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "import:manufacturers": "tsx scripts/import-manufacturers.ts",
    "deploy": "zsh scripts/deploy.sh",
    "fetch:fx": "tsx scripts/fetch-fx.ts",
    "research:photos": "tsx scripts/research/photos.ts",
    "research:feedback": "tsx scripts/research/feedback.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "d3-geo": "^3.1.2",
    "i18n-iso-countries": "^7.14.0",
    "preact": "^11.2.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
