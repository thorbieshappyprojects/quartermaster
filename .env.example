# Copy to .env (gitignored) and fill in. Never commit .env.

# Anthropic API key for the research scripts (scripts/research/*).
ANTHROPIC_API_KEY=
# Hard spending cap for research runs in USD; scripts stop before exceeding it.
RESEARCH_BUDGET_USD=20

# Cloudflare Pages deploy (M3). Only needed locally if deploying by hand;
# CI reads these from GitHub Actions secrets.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
