{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quartermaster.local/schemas/category.schema.json",
  "title": "Category (data/categories/<id>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "domain", "wave", "indicators", "category_card", "sources"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "name": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "wave": { "type": "integer", "minimum": 1 },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "unit", "trump"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
          "label": { "type": "string" },
          "unit": { "type": "string" },
          "trump": { "enum": ["higher_wins", "lower_wins", "not_playable"] },
          "decimals": { "type": "integer", "minimum": 0, "maximum": 3 },
          "derived": {
            "description": "Computed at build time from two sourced indicators; never stored on a card.",
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "numerator", "denominator"],
            "properties": {
              "op": { "const": "divide" },
              "numerator": { "type": "string" },
              "denominator": { "type": "string" },
              "factor": { "type": "number" }
            }
          },
          "description": { "type": "string" }
        }
      }
    },
    "category_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "purpose", "strengths", "weaknesses", "counters", "trends"],
      "properties": {
        "summary": { "type": "string" },
        "purpose": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sourcedText" } },
        "strengths": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sourcedText" } },
        "weaknesses": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sourcedText" } },
        "counters": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sourcedText" } },
        "trends": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sourcedText" } }
      }
    },
    "sources": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/source" } }
  }
}
